# Copy to backend/.env and replace only the placeholder values.
PORT=4000

# Local MongoDB default. Preserve query options such as ?authSource=admin for hosted databases.
MONGODB_URI=mongodb://127.0.0.1:27017/vizzy_db

# Optional Gemini text model for story breakdown and dialogue.
AI_API_KEY=replace-with-gemini-text-api-key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# Gemini image model access requires a project with image quota and billing eligibility.
GEMINI_API_KEY=replace-with-gemini-image-api-key
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional image fallback. This must be a Pollinations server key, not a Google key.
POLLINATIONS_API_KEY=replace-with-pollinations-server-key
